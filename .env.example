# --- Claude auth ---
# This app uses the Claude Agent SDK with subscription auth (Pro / Max).
# Run `claude login` once in your terminal; the SDK picks up the OAuth credentials
# automatically — no key needed here.
#
# IMPORTANT: if ANTHROPIC_API_KEY is set anywhere in your environment, the SDK uses
# THAT instead of your subscription (and you get billed per-call). Leave it unset to
# use your Claude subscription credits.
# ANTHROPIC_API_KEY=

# Models used by each path. Leave blank to use SDK defaults.
ROUTER_MODEL=claude-haiku-4-5-20251001
GENERATION_MODEL=claude-sonnet-4-6

# --- Databricks workspace ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=

# Unity Catalog location for the support corpus (Vector Search REQUIRES UC)
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=pharma_copilot

# Existing pharma_sales tables (already built — in Unity Catalog)
SALES_CATALOG=workspace
SALES_SCHEMA=pharma_sales

# --- Vector Search ---
EMBEDDING_ENDPOINT=databricks-gte-large-en
VECTOR_SEARCH_ENDPOINT=pharma_copilot_endpoint
SOURCE_TABLE=support_corpus_chunks
INDEX_NAME=support_corpus_index

# --- Retrieval tuning ---
TOP_K=5
SIMILARITY_THRESHOLD=0.3
